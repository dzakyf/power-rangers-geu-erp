APP_NAME="GREEN ENERGI UTAMA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

# Module composition:
# BDP:   core,credential,bp,finance
# CNS:   core,credential,cns
# HCGA:  core,credential,cns,hcga
# Full:  core,credential,bp,finance,cns,hcga,legacy
MODULES=core,credential,bp,finance

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_local
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Notification stream (SSE)
NOTIFICATION_SSE_ENABLED=true
NOTIFICATION_SSE_STREAM_SECONDS=30
NOTIFICATION_SSE_POLL_INTERVAL=2
NOTIFICATION_SSE_HEARTBEAT_SECONDS=15
NOTIFICATION_POLL_SECONDS=30

# Optional integrations
GA_EMAIL_NOTIFICATIONS=false
TRACEABILITY_SHOW_BDP=false
SANCTUM_TOKEN_EXPIRATION=10080

APIPI_BASE_URL=https://apipi.greenenergiutama.co.id
APIPI_EMAIL=
APIPI_PASSWORD=
APIPI_TIMEOUT=30
APIPI_VERIFY_TLS=true
APIPI_SESSION_TTL=1500
APIPI_THROTTLE_MS=150
APIPI_CACHE_PATH=
