RewriteEngine On
RewriteBase /

# Protect the htaccess file
<Files .htaccess>
Order Allow,Deny
Deny from all
</Files>

# Protect log.txt
<Files .env>
Order Allow,Deny
Deny from all
</Files>

# Disable directory browsing
Options All -Indexes

	
<IfModule mod_rewrite.c>
 
RewriteEngine On
 
RewriteRule ^(.*)$ public/$1 [L]
 
</IfModule>